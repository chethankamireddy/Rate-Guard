datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AlgorithmType {
  TOKEN_BUCKET
  SLIDING_WINDOW
}

enum PolicyScope {
  API_KEY
  ENDPOINT
  GLOBAL
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
}

enum KeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RequestDecision {
  ALLOWED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  apiKeys      ApiKey[]

  @@map("users")
}

model RateLimitPolicy {
  id             String        @id @default(uuid())
  name           String
  description    String?
  algorithm      AlgorithmType @default(TOKEN_BUCKET)
  requestLimit   Int           @map("request_limit")
  windowDuration Int           @map("window_duration") // in seconds
  burstCapacity  Int           @default(100) @map("burst_capacity")
  scope          PolicyScope   @default(API_KEY)
  status         PolicyStatus  @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  apiKeys        ApiKey[]

  @@map("rate_limit_policies")
}

model ApiKey {
  id          String        @id @default(uuid())
  name        String
  keyPrefix   String        @map("key_prefix") // e.g. "rg_live_a1b2..."
  keyHash     String        @unique @map("key_hash") // SHA-256 hash of raw key
  userId      String        @map("user_id")
  policyId    String?       @map("policy_id")
  status      KeyStatus     @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  expiresAt   DateTime?     @map("expires_at")
  lastUsedAt  DateTime?     @map("last_used_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy      RateLimitPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  requestLogs RequestLog[]

  @@index([keyHash])
  @@index([status])
  @@map("api_keys")
}

model RequestLog {
  id          String          @id @default(uuid())
  apiKeyId    String?         @map("api_key_id")
  endpoint    String
  method      String
  statusCode  Int             @map("status_code")
  decision    RequestDecision
  latencyMs   Float           @map("latency_ms")
  algorithm   String
  ipAddress   String?         @map("ip_address")
  timestamp   DateTime        @default(now())

  apiKey      ApiKey?         @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([apiKeyId])
  @@index([decision])
  @@index([endpoint])
  @@map("request_logs")
}

model AggregatedMetric {
  id               String   @id @default(uuid())
  bucketTime       DateTime @map("bucket_time")
  totalRequests    Int      @default(0) @map("total_requests")
  allowedRequests  Int      @default(0) @map("allowed_requests")
  rejectedRequests Int      @default(0) @map("rejected_requests")
  avgLatencyMs     Float    @default(0.0) @map("avg_latency_ms")
  algorithm        String?
  endpoint         String?

  @@unique([bucketTime, endpoint, algorithm])
  @@index([bucketTime])
  @@map("aggregated_metrics")
}
