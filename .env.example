# RateGuard Platform Environment Configuration

# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=rateguard-super-secret-jwt-key-2026

# Database & Cache
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/rateguard?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# Rate Limiting Engine
CPP_ENGINE_URL="http://127.0.0.1:7070"
RATE_LIMITER_MODE=AUTO  # AUTO | CPP | REDIS
DEFAULT_ALGORITHM=TOKEN_BUCKET # TOKEN_BUCKET | SLIDING_WINDOW
DEFAULT_LIMIT=100
DEFAULT_WINDOW_DURATION=60

# Frontend
CORS_ORIGIN="*"
VITE_API_URL="http://localhost:4000"
